# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# DB_HOST is replaced by scripts/dev-infra.sh:
#   - "localhost" in native Docker mode
#   - "postgres" in Docker-in-Docker mode (dev containers, Codespaces)
DEVRANK_DATABASE_URL=postgresql+asyncpg://devrank:devrank@DB_HOST:5432/devrank
DEVRANK_DATABASE_URL_SYNC=postgresql://devrank:devrank@DB_HOST:5432/devrank

# ── Redis (Celery broker / result backend) ────────────────────────────────────
# DEVRANK_REDIS_URL for health/etc; Celery now uses DEVRANK_CELERY_* to match
# Pydantic Settings env_prefix (DRY/standardization; see config.py refactor).
# REDIS_HOST placeholder substituted by scripts/dev-infra.sh (localhost vs. redis in DinD).
DEVRANK_REDIS_URL=redis://REDIS_HOST:6379/0
DEVRANK_CELERY_BROKER_URL=redis://REDIS_HOST:6379/0
DEVRANK_CELERY_BACKEND_URL=redis://REDIS_HOST:6379/1

# ── Auth ──────────────────────────────────────────────────────────────────────
DEVRANK_SECRET_KEY=local-dev-secret-change-in-production

# GitHub OAuth (https://github.com/settings/developers)
DEVRANK_GITHUB_CLIENT_ID=
DEVRANK_GITHUB_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
DEVRANK_GOOGLE_CLIENT_ID=
DEVRANK_GOOGLE_CLIENT_SECRET=

# ── API ───────────────────────────────────────────────────────────────────────
DEVRANK_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEVRANK_ALLOWED_DUMP_DIRS=/tmp:dumps
